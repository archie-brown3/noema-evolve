import sys; sys.path.insert(0, '/tmp/noema-agent-burst-fm-hifo-opencode/mutations/it000001/m01')
import child
import numpy as np

# Count evaluations
class Tracker:
    def __init__(self): self.count = 0

_orig_eval = child.evaluate_function
tracker = Tracker()
def tracked(x, y):
    tracker.count += 1
    return _orig_eval(x, y)
child.evaluate_function = tracked

np.random.seed(42)
x, y, v = child.run_search()
print(f'Found ({x:.6f}, {y:.6f}) val={v:.6f}, evals={tracker.count}')

# Test 20 seeds
vals = []
eval_counts = []
for seed in range(20):
    np.random.seed(seed)
    tracker.count = 0
    x, y, v = child.run_search()
    vals.append(v)
    eval_counts.append(tracker.count)
print(f'Min: {min(vals):.6f} Mean: {np.mean(vals):.6f} Std: {np.std(vals):.6f}')
print(f'Evals: min={min(eval_counts)} max={max(eval_counts)} mean={np.mean(eval_counts):.1f}')
